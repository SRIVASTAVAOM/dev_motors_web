# ==============================================================================
# DEV MOTORS WEB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & PRISMA CONNECTIVITY
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Connects via Supabase Transaction Connection Pooler (Port 6543)
# Used for runtime queries in serverless/edge environments (Next.js App Router).
# Transaction mode pooler (?pgbouncer=true) minimizes connection exhaustion.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct TCP connection (Session mode, Port 5432)
# Required by Prisma for CLI operations (prisma db push, prisma migrate dev).
# Transaction poolers cannot handle Prisma transactional DDL locks & prepared statements.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# SUPABASE CLIENT CREDENTIALS (Authentication & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
